<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.App.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_btn</item>
        <item name="android:textColor">@color/text_black</item>
        <item name="android:paddingLeft">@dimen/btn_padding_h</item>
        <item name="android:paddingRight">@dimen/btn_padding_h</item>
        <item name="android:paddingTop">@dimen/btn_padding_v</item>
        <item name="android:paddingBottom">@dimen/btn_padding_v</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.App.Button" />

    <style name="Widget.App.Button.Success" parent="Widget.App.Button">
        <item name="android:background">@drawable/bg_btn_success</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.App.Button">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textSize">@dimen/text_btn_big</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="Widget.App.Button.Neutral" parent="Widget.App.Button">
        <item name="android:background">@drawable/bg_btn_neutral</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.App.Button.Play" parent="Widget.App.Button.Success">
        <item name="android:textSize">@dimen/text_btn_play</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="TextAppearance.App.InstanceName" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">@dimen/text_instance</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>